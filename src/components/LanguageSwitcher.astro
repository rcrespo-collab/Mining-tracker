---
import { alternatePath, normalizePath, type Locale } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const path = normalizePath(Astro.url.pathname);

const enHref = alternatePath(path, 'en');
const ptHref = alternatePath(path, 'pt');
---

<nav class="lang-switch" aria-label={t.langSwitch.label}>
  <a
    href={enHref}
    hreflang="en"
    lang="en"
    data-lang-set="en"
    class:list={['lang-opt', { 'is-active': locale === 'en' }]}
    aria-current={locale === 'en' ? 'true' : undefined}
  >
    {t.langSwitch.en}
  </a>
  <span aria-hidden="true" class="lang-sep">/</span>
  <a
    href={ptHref}
    hreflang="pt-PT"
    lang="pt-PT"
    data-lang-set="pt"
    class:list={['lang-opt', { 'is-active': locale === 'pt' }]}
    aria-current={locale === 'pt' ? 'true' : undefined}
  >
    {t.langSwitch.pt}
  </a>
</nav>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: 0.06em;
  }
  .lang-opt {
    color: var(--color-slate);
    text-decoration: none;
    padding: 0.15rem 0.1rem;
  }
  .lang-opt:hover {
    color: var(--color-ink);
  }
  .lang-opt.is-active {
    color: var(--color-ink);
    font-weight: 500;
  }
  .lang-sep {
    color: var(--color-hairline);
  }
  :global(.on-dark) .lang-opt {
    color: rgba(255, 255, 255, 0.7);
  }
  :global(.on-dark) .lang-opt:hover,
  :global(.on-dark) .lang-opt.is-active {
    color: var(--color-paper);
  }
  :global(.on-dark) .lang-sep {
    color: rgba(255, 255, 255, 0.35);
  }
</style>
