---
import { routeFor, withBase, type Locale } from '../i18n/routes';
import { ui } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const year = 2026;

const labels =
  locale === 'pt'
    ? {
        strategic: 'Consultoria Estratégica',
        investment: 'Consultoria de Investimento',
        project: 'Gestão de Projetos',
        angola: 'Entrada no mercado angolano',
        ai: 'AI Readiness',
        extractives: 'Setor Extrativo',
        ict: 'Tecnologia, Informação e Telecom',
        financial: 'Serviços Financeiros',
        public: 'Setor Público',
        agri: 'Agronegócio e Indústria',
        about: 'Quem somos',
        approach: 'A nossa abordagem',
        sellSide: 'Processo sell-side',
        buySide: 'Processo buy-side',
        credentials: 'Credenciais',
        contact: 'Contacto',
      }
    : {
        strategic: 'Strategic Advisory',
        investment: 'Investment Advisory',
        project: 'Project Management',
        angola: 'Angola Market Entry',
        ai: 'AI Readiness',
        extractives: 'Extractives',
        ict: 'Technology, Information & Telecom',
        financial: 'Financial Services',
        public: 'Public Sector',
        agri: 'Agribusiness & Industry',
        about: 'About us',
        approach: 'Our approach',
        sellSide: 'Sell-side process',
        buySide: 'Buy-side process',
        credentials: 'Credentials',
        contact: 'Contact',
      };

const services = [
  { label: labels.strategic, href: routeFor('strategic-advisory', locale) },
  { label: labels.investment, href: routeFor('investment-advisory', locale) },
  { label: labels.project, href: routeFor('project-management', locale) },
  { label: labels.angola, href: routeFor('angola-market-entry', locale) },
  { label: labels.ai, href: routeFor('ai-readiness', locale) },
];
const sectors = [
  { label: labels.extractives, href: routeFor('extractives', locale) },
  { label: labels.ict, href: routeFor('ict', locale) },
  { label: labels.financial, href: routeFor('financial-services', locale) },
  { label: labels.public, href: routeFor('public-sector', locale) },
  { label: labels.agri, href: routeFor('agribusiness-industry', locale) },
];
const explore = [
  { label: labels.about, href: routeFor('about', locale) },
  { label: labels.approach, href: routeFor('approach', locale) },
  { label: labels.sellSide, href: routeFor('sell-side', locale) },
  { label: labels.buySide, href: routeFor('buy-side', locale) },
  { label: labels.credentials, href: routeFor('credentials', locale) },
  { label: labels.contact, href: routeFor('contact', locale) },
];
---

<footer class="site-footer surface-ink on-dark">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={routeFor('home', locale)} class="footer-logo" aria-label="Nyawira Consulting">
        <img src={withBase('/logos/nyawira-mark.svg')} width="28" height="28" alt="" />
        <span>Nyawira</span>
      </a>
      <p class="footer-positioning">{t.footer.positioning}</p>
    </div>

    <nav class="footer-col" aria-label={t.footer.servicesHeading}>
      <h2 class="footer-heading mono">{t.footer.servicesHeading}</h2>
      <ul>
        {services.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer-col" aria-label={t.footer.sectorsHeading}>
      <h2 class="footer-heading mono">{t.footer.sectorsHeading}</h2>
      <ul>
        {sectors.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer-col" aria-label={t.footer.exploreHeading}>
      <h2 class="footer-heading mono">{t.footer.exploreHeading}</h2>
      <ul>
        {explore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-col footer-contact">
      <h2 class="footer-heading mono">{t.footer.contactHeading}</h2>
      <ul>
        <li><a href="mailto:info@nyawiraconsulting.com">info@nyawiraconsulting.com</a></li>
        <li><span class="footer-muted">{t.footer.address}</span></li>
        <li><a href={t.footer.linkedin}>LinkedIn</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <div class="footer-legal">
      <span>© {year} Nyawira Consulting. {t.footer.rights}</span>
      <a href={routeFor('privacy', locale)}>{t.footer.privacy}</a>
      <a href={routeFor('cookies', locale)}>{t.footer.cookies}</a>
    </div>
    <LanguageSwitcher locale={locale} />
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink-deep);
    padding-block: clamp(3rem, 6vw, 5rem) 2rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  .footer-brand {
    max-width: 34ch;
  }
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
  }
  .footer-logo:hover {
    color: var(--color-paper);
  }
  .footer-positioning {
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .footer-heading {
    color: var(--color-cyan);
    margin: 0 0 1rem;
    font-size: var(--text-caption);
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer-col a {
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    font-size: 0.925rem;
  }
  .footer-col a:hover {
    color: var(--color-cyan);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .footer-muted {
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.925rem;
  }
  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    color: rgba(255, 255, 255, 0.6);
    font-size: var(--text-caption);
  }
  .footer-legal a {
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
  }
  .footer-legal a:hover {
    color: var(--color-cyan);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 960px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr 1fr;
      gap: 2rem;
    }
    .footer-bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
