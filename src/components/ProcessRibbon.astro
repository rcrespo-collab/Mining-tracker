---
/**
 * The process ribbon — the site's signature element (approach pages only).
 *
 * Upper track (Nyawira): numbered phases with mono durations, the marker line
 * RISING across the sequence on the navy gradient with cyan markers.
 * Lower track (typical alternative): flat, muted, hairline-bordered, slate on
 * mist, no numbers, no durations. The vertical gap between the tracks widens
 * across the sequence — that gap IS the argument the firm makes.
 *
 * This is the ONLY place on the site where 01 / 02 / 03 numbering appears.
 * Below 768px it becomes a vertical stepper and the contrast track collapses
 * into a single summary panel.
 */
import type { Locale } from '../i18n/routes';

export interface RibbonPhase {
  n: number;
  phase: string;
  duration?: string;
  detail: string;
}

interface Props {
  locale: Locale;
  phases: RibbonPhase[];
  outcomeLabel: string;
  typicalTitle: string;
  typicalPoints: string[];
}

const { locale, phases, outcomeLabel, typicalTitle, typicalPoints } = Astro.props;

const L =
  locale === 'pt'
    ? { nyawira: 'Nyawira', alt: 'A alternativa típica', outcome: 'Resultado', durationTbd: '—' }
    : { nyawira: 'Nyawira', alt: 'The typical alternative', outcome: 'Outcome', durationTbd: '—' };

const N = phases.length;
// Coordinate math (percent) shared by the SVG lines and the HTML markers.
const pct = (i: number, lo: number, hi: number) => (N === 1 ? (lo + hi) / 2 : lo + (i * (hi - lo)) / (N - 1));
const xs = phases.map((_, i) => pct(i, 9, 91));
// Nyawira rises: earlier phases low (larger top%), later phases high (smaller top%).
const nyY = phases.map((_, i) => pct(i, 68, 24));
const typY = 88;

const nyLine = xs.map((x, i) => `${x},${nyY[i]}`).join(' ');
const typLine = xs.map((x) => `${x},${typY}`).join(' ');
---

<figure class="ribbon" data-reveal>
  <figcaption class="ribbon-head">
    <span class="mono ribbon-track-label ribbon-track-label--nyawira">{L.nyawira}</span>
    <span class="mono ribbon-outcome">
      <span aria-hidden="true">→ </span>{L.outcome}: {outcomeLabel}
    </span>
  </figcaption>

  <!-- ===================== Desktop: rising ribbon ===================== -->
  <div class="ribbon-desktop surface-gradient on-dark">
    <div class="ribbon-stage">
      <svg class="ribbon-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <polyline points={typLine} fill="none" stroke="rgba(255,255,255,0.28)" stroke-width="0.3" stroke-dasharray="1.4 1.4" />
        <polyline points={nyLine} fill="none" stroke="var(--color-cyan)" stroke-width="0.5" />
      </svg>

      {
        phases.map((p, i) => (
          <div class="ny-node" style={`left:${xs[i]}%;top:${nyY[i]}%`}>
            <span class="ny-marker" aria-hidden="true" />
            <span class="mono ny-num">{String(p.n).padStart(2, '0')}</span>
            <span class="ny-name">{p.phase}</span>
            {p.duration && <span class="mono ny-duration">{p.duration}</span>}
          </div>
        ))
      }

      {
        xs.map((x) => (
          <span class="typ-marker" style={`left:${x}%;top:${typY}%`} aria-hidden="true" />
        ))
      }
      <span class="mono typ-label" style={`top:${typY}%`}>{L.alt}</span>
    </div>

    <!-- Full phase detail, aligned in columns beneath the rising line. -->
    <ol class="ribbon-detail" style={`--cols:${N}`}>
      {
        phases.map((p) => (
          <li>
            <span class="mono ny-num">{String(p.n).padStart(2, '0')}</span>
            <h3 class="ny-detail-name">{p.phase}</h3>
            {p.duration && <span class="mono ny-duration-inline">{p.duration}</span>}
            <p class="ny-detail-text">{p.detail}</p>
          </li>
        ))
      }
    </ol>
  </div>

  <!-- Lower track: flat contrast panel -->
  <div class="ribbon-typical surface-mist">
    <span class="mono typical-alt">{L.alt}</span>
    <span class="mono typical-title">{typicalTitle}</span>
    <ul class="typical-points">
      {typicalPoints.map((pt) => <li>{pt}</li>)}
    </ul>
  </div>

  <!-- ===================== Mobile: vertical stepper ===================== -->
  <ol class="ribbon-mobile surface-gradient on-dark">
    {
      phases.map((p) => (
        <li class="step">
          <span class="mono step-num">{String(p.n).padStart(2, '0')}</span>
          <div class="step-body">
            <h3 class="step-name">{p.phase}</h3>
            {p.duration && <span class="mono step-duration">{p.duration}</span>}
            <p class="step-detail">{p.detail}</p>
          </div>
        </li>
      ))
    }
    <li class="step step-outcome">
      <span class="mono step-num step-num--outcome" aria-hidden="true">→</span>
      <div class="step-body">
        <span class="mono step-outcome-label">{L.outcome}</span>
        <p class="step-outcome-value">{outcomeLabel}</p>
      </div>
    </li>
  </ol>
</figure>

<style>
  .ribbon {
    margin: 0;
  }
  .ribbon-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .ribbon-track-label--nyawira {
    color: var(--color-blue);
    letter-spacing: 0.12em;
  }
  .ribbon-outcome {
    color: var(--color-ink);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  /* ---------- Desktop ---------- */
  .ribbon-desktop {
    display: none;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: 0;
  }
  .ribbon-stage {
    position: relative;
    width: 100%;
    height: clamp(300px, 34vw, 420px);
  }
  .ribbon-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ny-node {
    position: absolute;
    transform: translate(-50%, -50%);
    width: clamp(120px, 15vw, 180px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.3rem;
  }
  .ny-marker {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-cyan);
    box-shadow: 0 0 0 5px rgba(33, 198, 201, 0.2);
  }
  .ny-num {
    color: var(--color-cyan);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }
  .ny-name {
    font-family: var(--font-display);
    font-size: 0.98rem;
    line-height: 1.2;
    color: var(--color-paper);
  }
  .ny-duration {
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: none;
  }
  .typ-marker {
    position: absolute;
    width: 8px;
    height: 8px;
    transform: translate(-50%, -50%);
    background: rgba(255, 255, 255, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.5);
  }
  .typ-label {
    position: absolute;
    left: 0;
    transform: translateY(1.2rem);
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.08em;
  }

  .ribbon-detail {
    list-style: none;
    margin: 2rem 0 0;
    padding: 2rem 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 1.5rem;
  }
  .ribbon-detail li {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .ny-detail-name {
    font-size: 1.02rem;
    color: var(--color-paper);
    line-height: 1.2;
  }
  .ny-duration-inline {
    color: var(--color-cyan);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: none;
  }
  .ny-detail-text {
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  /* ---------- Lower contrast track ---------- */
  .ribbon-typical {
    border: 1px solid var(--color-hairline);
    border-top: none;
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
  .typical-alt {
    display: block;
    color: var(--color-slate);
    letter-spacing: 0.12em;
    opacity: 0.75;
    margin-bottom: 0.35rem;
  }
  .typical-title {
    display: block;
    color: var(--color-ink);
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }
  .typical-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    grid-template-columns: 1fr;
  }
  .typical-points li {
    color: var(--color-slate);
    font-size: 0.95rem;
    padding-left: 1.1rem;
    position: relative;
  }
  .typical-points li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--color-slate);
  }

  /* ---------- Mobile stepper ---------- */
  .ribbon-mobile {
    list-style: none;
    margin: 0;
    padding: clamp(1.5rem, 6vw, 2rem);
    display: flex;
    flex-direction: column;
  }
  .step {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding-bottom: 1.75rem;
    position: relative;
  }
  .step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(1.25rem - 1px);
    top: 1.9rem;
    bottom: 0;
    width: 2px;
    background: rgba(33, 198, 201, 0.35);
  }
  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-cyan);
    color: var(--color-cyan);
    font-size: 0.8rem;
    background: var(--color-ink);
    z-index: 1;
  }
  .step-num--outcome {
    border-style: solid;
    font-size: 1.1rem;
  }
  .step-name {
    font-size: 1.15rem;
    color: var(--color-paper);
  }
  .step-duration {
    display: block;
    margin-top: 0.3rem;
    color: var(--color-cyan);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: none;
  }
  .step-detail {
    margin-top: 0.5rem;
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .step-outcome-label {
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.08em;
  }
  .step-outcome-value {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-cyan);
    margin-top: 0.25rem;
  }

  @media (min-width: 768px) {
    .ribbon-desktop {
      display: block;
    }
    .ribbon-mobile {
      display: none;
    }
    .typical-points {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.6rem 2rem;
    }
  }
  @media (min-width: 1100px) {
    .typical-points {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
