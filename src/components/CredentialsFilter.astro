---
import type { Credential } from '../content/shared';
import { credentials as allCredentials, credentialGroupLabel, type CredentialGroup } from '../content/shared';
import type { Locale } from '../i18n/routes';
import { ui } from '../i18n/ui';
import CredentialCard from './CredentialCard.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];

const serviceOptions = [
  { value: 'all', label: t.filter.all },
  { value: 'strategic', label: t.filter.services.strategic },
  { value: 'investment', label: t.filter.services.investment },
  { value: 'project', label: t.filter.services.project },
];
const sectorOptions = [
  { value: 'all', label: t.filter.all },
  { value: 'extractives', label: t.filter.sectors.extractives },
  { value: 'ict', label: t.filter.sectors.ict },
  { value: 'financial', label: t.filter.sectors.financial },
  { value: 'public', label: t.filter.sectors.public },
  { value: 'agri', label: t.filter.sectors.agri },
];

// Group the credentials for a sensible default (no-JS) ordering.
const groups: CredentialGroup[] = ['sell-side', 'buy-side', 'jv', 'fund'];
const grouped: { group: CredentialGroup; items: Credential[] }[] = groups
  .map((group) => ({ group, items: allCredentials.filter((c) => c.group === group) }))
  .filter((g) => g.items.length > 0);
---

<div class="cred-filter" data-cred-filter>
  <div class="filter-controls">
    <fieldset class="filter-group" data-filter-group="services">
      <legend class="mono filter-legend">{t.filter.byService}</legend>
      <div class="filter-chips" role="group" aria-label={t.filter.byService}>
        {
          serviceOptions.map((o, i) => (
            <button
              type="button"
              class="filter-chip"
              data-filter-value={o.value}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {o.label}
            </button>
          ))
        }
      </div>
    </fieldset>

    <fieldset class="filter-group" data-filter-group="sectors">
      <legend class="mono filter-legend">{t.filter.bySector}</legend>
      <div class="filter-chips" role="group" aria-label={t.filter.bySector}>
        {
          sectorOptions.map((o, i) => (
            <button
              type="button"
              class="filter-chip"
              data-filter-value={o.value}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {o.label}
            </button>
          ))
        }
      </div>
    </fieldset>
  </div>

  <p class="filter-count mono" data-filter-count role="status" aria-live="polite"></p>

  <div class="cred-results">
    {
      grouped.map((g) => (
        <section class="cred-group" data-cred-group={g.group}>
          <h2 class="cred-group-title mono">{credentialGroupLabel[g.group][locale]}</h2>
          <div class="cred-grid">
            {g.items.map((c) => <CredentialCard credential={c} locale={locale} />)}
          </div>
        </section>
      ))
    }
    <p class="cred-empty" data-cred-empty hidden>
      {locale === 'pt' ? 'Nenhuma credencial corresponde a este filtro.' : 'No credentials match this filter.'}
    </p>
  </div>
</div>

<style>
  .filter-controls {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-hairline);
  }
  .filter-group {
    border: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .filter-legend {
    color: var(--color-slate);
    letter-spacing: 0.1em;
    padding: 0;
  }
  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filter-chip {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-graphite);
    background: var(--color-paper);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-btn);
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    transition: border-color 140ms var(--ease-out), color 140ms var(--ease-out);
  }
  .filter-chip:hover {
    border-color: var(--color-slate);
  }
  .filter-chip[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }
  .filter-count {
    color: var(--color-slate);
    letter-spacing: 0.06em;
    text-transform: none;
    margin: 1.5rem 0 0;
    min-height: 1.2em;
  }
  .cred-results {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .cred-group-title {
    color: var(--color-blue);
    letter-spacing: 0.1em;
    margin: 0 0 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-hairline);
  }
  .cred-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .cred-empty {
    color: var(--color-slate);
    font-size: 1.05rem;
  }
  @media (min-width: 640px) {
    .filter-controls {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .cred-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .cred-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-cred-filter]');
  if (root) {
    const state: Record<string, string> = { services: 'all', sectors: 'all' };
    const countEl = root.querySelector<HTMLElement>('[data-filter-count]');
    const emptyEl = root.querySelector<HTMLElement>('[data-cred-empty]');
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-credential]'));
    const groupSections = Array.from(root.querySelectorAll<HTMLElement>('[data-cred-group]'));

    const params = new URLSearchParams(window.location.search);
    const validate = (group: string, val: string | null): string => {
      if (!val) return 'all';
      const btn = root.querySelector(`[data-filter-group="${group}"] [data-filter-value="${val}"]`);
      return btn ? val : 'all';
    };
    state.services = validate('services', params.get('service'));
    state.sectors = validate('sectors', params.get('sector'));

    const syncButtons = () => {
      root.querySelectorAll<HTMLElement>('[data-filter-group]').forEach((group) => {
        const key = group.getAttribute('data-filter-group') || '';
        group.querySelectorAll<HTMLButtonElement>('[data-filter-value]').forEach((btn) => {
          const pressed = btn.getAttribute('data-filter-value') === state[key];
          btn.setAttribute('aria-pressed', pressed ? 'true' : 'false');
        });
      });
    };

    const matches = (card: HTMLElement): boolean => {
      const svc = (card.getAttribute('data-services') || '').split(' ');
      const sec = (card.getAttribute('data-sectors') || '').split(' ');
      const svcOk = state.services === 'all' || svc.includes(state.services);
      const secOk = state.sectors === 'all' || sec.includes(state.sectors);
      return svcOk && secOk;
    };

    const apply = () => {
      let visible = 0;
      cards.forEach((card) => {
        const show = matches(card);
        card.hidden = !show;
        if (show) visible += 1;
      });
      // Hide group headings that have no visible cards.
      groupSections.forEach((section) => {
        const anyVisible = section.querySelectorAll('[data-credential]:not([hidden])').length > 0;
        section.hidden = !anyVisible;
      });
      if (emptyEl) emptyEl.hidden = visible !== 0;
      if (countEl) {
        const total = cards.length;
        const showingWord = document.documentElement.lang.startsWith('pt') ? 'A mostrar' : 'Showing';
        countEl.textContent = `${showingWord} ${visible} / ${total}`;
      }

      const url = new URL(window.location.href);
      state.services === 'all' ? url.searchParams.delete('service') : url.searchParams.set('service', state.services);
      state.sectors === 'all' ? url.searchParams.delete('sector') : url.searchParams.set('sector', state.sectors);
      window.history.replaceState({}, '', url);
    };

    root.querySelectorAll<HTMLElement>('[data-filter-group]').forEach((group) => {
      const key = group.getAttribute('data-filter-group') || '';
      group.querySelectorAll<HTMLButtonElement>('[data-filter-value]').forEach((btn) => {
        btn.addEventListener('click', () => {
          state[key] = btn.getAttribute('data-filter-value') || 'all';
          syncButtons();
          apply();
        });
      });
    });

    syncButtons();
    apply();
  }
</script>
