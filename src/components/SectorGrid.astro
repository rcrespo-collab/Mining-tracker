---
interface SectorLink {
  label: string;
  href: string;
}
interface Props {
  sectors: SectorLink[];
}
const { sectors } = Astro.props;
---

<ul class="sector-grid">
  {
    sectors.map((s) => (
      <li>
        <a href={s.href} class="sector-link">
          <span>{s.label}</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h9M8 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .sector-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-hairline);
  }
  .sector-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--color-hairline);
    text-decoration: none;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    transition: padding-left 160ms var(--ease-out), color 160ms var(--ease-out);
  }
  .sector-link:hover {
    padding-left: 0.5rem;
    color: var(--color-blue);
  }
  .sector-link svg {
    color: var(--color-cyan);
    flex-shrink: 0;
  }
</style>
