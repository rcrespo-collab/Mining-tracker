---
import PageLayout from '../layouts/PageLayout.astro';
import ProcessRibbon from './ProcessRibbon.astro';
import ClosingCta from './ClosingCta.astro';
import type { ProcessPageContent } from '../content/types';
import { routeFor, type Locale } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
  content: ProcessPageContent;
}
const { locale, content: p } = Astro.props;
const t = ui[locale];
---

<PageLayout
  locale={locale}
  title={p.meta.title}
  description={p.meta.description}
  eyebrow={t.nav.approach}
  heading={p.heading}
  heroVariant="gradient"
  breadcrumb={[
    { label: t.breadcrumbHome, href: routeFor('home', locale) },
    { label: t.nav.approach, href: routeFor('approach', locale) },
    { label: p.heading },
  ]}
>
  <section class="section">
    <div class="container">
      <ProcessRibbon
        locale={locale}
        phases={p.phases}
        outcomeLabel={p.outcomeLabel}
        typicalTitle={p.contrastTitle}
        typicalPoints={p.contrastPoints}
      />
    </div>
  </section>

  <section class="section surface-mist">
    <div class="container">
      <h2 class="tailored-title">{p.tailoredTitle}</h2>
      <ul class="tailored-list">
        {
          p.tailoredPoints.map((pt) => (
            <li>
              <span class="tailored-mark" aria-hidden="true" />
              <span>{pt}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ClosingCta
    heading={p.heading}
    ctaHref={routeFor('contact', locale)}
    ctaLabel={t.cta.discussTransaction}
    variant="gradient"
  />
</PageLayout>

<style>
  .tailored-title {
    font-size: var(--text-display-m);
    margin-bottom: 2rem;
  }
  .tailored-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    max-width: 60rem;
  }
  .tailored-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    font-size: var(--text-body-l);
    color: var(--color-graphite);
    line-height: 1.55;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-hairline);
  }
  .tailored-mark {
    width: 8px;
    height: 8px;
    margin-top: 0.55rem;
    background: var(--color-cyan);
    flex-shrink: 0;
  }
</style>
