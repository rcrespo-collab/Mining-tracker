---
import PageLayout from '../layouts/PageLayout.astro';
import type { SimplePageContent } from '../content/types';
import { routeFor, type Locale } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
  content: SimplePageContent;
}
const { locale, content: p } = Astro.props;
const t = ui[locale];
---

<PageLayout
  locale={locale}
  title={p.meta.title}
  description={p.meta.description}
  heading={p.heading}
  breadcrumb={[{ label: t.breadcrumbHome, href: routeFor('home', locale) }, { label: p.heading }]}
>
  <section class="section">
    <div class="container-narrow">
      <p class="simple-body">{p.body}</p>
    </div>
  </section>
</PageLayout>

<style>
  .simple-body {
    font-size: var(--text-body-l);
    color: var(--color-graphite);
    line-height: 1.7;
    white-space: pre-line;
  }
</style>
