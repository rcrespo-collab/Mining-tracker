---
interface Props {
  quote: string;
  attribution?: string;
}
const { quote, attribution } = Astro.props;
---

<blockquote class="pull-quote surface-gradient on-dark">
  <div class="container-narrow">
    <p class="pull-quote-text">{quote}</p>
    {attribution && <cite class="mono pull-quote-cite">{attribution}</cite>}
  </div>
</blockquote>

<style>
  .pull-quote {
    margin: 0;
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }
  .pull-quote-text {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-display-l);
    line-height: 1.2;
    color: var(--color-paper);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .pull-quote-cite {
    display: block;
    margin-top: 1.5rem;
    font-style: normal;
    color: var(--color-cyan);
    letter-spacing: 0.08em;
  }
</style>
