---
/**
 * Canonical CTA link. Only the approved CTA vocabulary is ever passed in.
 */
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'outline';
  class?: string;
}
const { href, label, variant = 'primary', class: className = '' } = Astro.props;
---

<a href={href} class:list={['btn', `btn-${variant}`, className]}>
  <span>{label}</span>
  <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none">
    <path d="M3 8h9M8 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>
