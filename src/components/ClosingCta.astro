---
import Cta from './Cta.astro';

interface Props {
  heading: string;
  body?: string;
  ctaHref: string;
  ctaLabel: string;
  variant?: 'gradient' | 'ink';
}
const { heading, body, ctaHref, ctaLabel, variant = 'gradient' } = Astro.props;
const surface = variant === 'ink' ? 'surface-ink' : 'surface-gradient';
---

<section class:list={['closing-cta on-dark', surface]}>
  <div class="container closing-inner">
    <div class="closing-text">
      <h2 class="closing-heading">{heading}</h2>
      {body && <p class="closing-body">{body}</p>}
    </div>
    <Cta href={ctaHref} label={ctaLabel} variant="primary" />
  </div>
</section>

<style>
  .closing-cta {
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  .closing-inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: flex-start;
  }
  .closing-heading {
    font-size: var(--text-display-m);
    color: var(--color-paper);
    max-width: 24ch;
    text-wrap: balance;
  }
  .closing-body {
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.85);
    max-width: 52ch;
  }
  @media (min-width: 860px) {
    .closing-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
    }
  }
</style>
