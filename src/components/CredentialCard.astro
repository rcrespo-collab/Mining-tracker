---
import type { Credential } from '../content/shared';
import type { Locale } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props {
  credential: Credential;
  locale: Locale;
}
const { credential: c, locale } = Astro.props;
const t = ui[locale];

const sectorLabel: Record<string, string> = {
  extractives: t.filter.sectors.extractives,
  ict: t.filter.sectors.ict,
  financial: t.filter.sectors.financial,
  public: t.filter.sectors.public,
  agri: t.filter.sectors.agri,
};
---

<article
  class="cred-card"
  data-credential
  data-services={c.services.join(' ')}
  data-sectors={c.sectors.join(' ')}
>
  <div class="cred-meta">
    <span class="mono cred-type">{c.type[locale]}</span>
    <span class="mono cred-status">{c.status[locale]}</span>
  </div>
  <p class="cred-text">{c.text[locale]}</p>
  <div class="cred-tags">
    <span class="mono cred-geo">{c.geography}</span>
    <span class="cred-sep" aria-hidden="true">·</span>
    <span class="cred-sectors mono">
      {c.sectors.map((s) => sectorLabel[s]).join(' · ')}
    </span>
  </div>
</article>

<style>
  .cred-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    background: var(--color-paper);
    border: 1px solid var(--color-hairline);
    height: 100%;
  }
  .cred-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--color-hairline);
  }
  .cred-type {
    color: var(--color-blue);
    letter-spacing: 0.06em;
  }
  .cred-status {
    color: var(--color-slate);
    letter-spacing: 0.06em;
    text-transform: none;
  }
  .cred-text {
    color: var(--color-graphite);
    font-size: 1rem;
    line-height: 1.55;
    flex: 1;
  }
  .cred-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-slate);
    font-size: 0.72rem;
  }
  .cred-geo {
    color: var(--color-ink);
    letter-spacing: 0.05em;
    text-transform: none;
  }
  .cred-sep {
    color: var(--color-hairline);
  }
  .cred-sectors {
    color: var(--color-slate);
    letter-spacing: 0.05em;
    text-transform: none;
  }
</style>
