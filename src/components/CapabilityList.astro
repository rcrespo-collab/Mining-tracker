---
import type { CapabilityItem } from '../content/types';
import { routeFor, type Locale } from '../i18n/routes';

interface Props {
  items: CapabilityItem[];
  locale: Locale;
}
const { items, locale } = Astro.props;
---

<ul class="capabilities">
  {
    items.map((item) => (
      <li class="capability">
        <span class="cap-mark" aria-hidden="true" />
        <span class="cap-text">
          {item.linkKey ? <a href={routeFor(item.linkKey, locale)}>{item.text}</a> : item.text}
        </span>
      </li>
    ))
  }
</ul>

<style>
  .capabilities {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  .capability {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1.15rem 0;
    border-top: 1px solid var(--color-hairline);
    font-size: var(--text-body-l);
    color: var(--color-graphite);
    line-height: 1.5;
  }
  .capability:last-child {
    border-bottom: 1px solid var(--color-hairline);
  }
  .cap-mark {
    width: 8px;
    height: 8px;
    margin-top: 0.5rem;
    background: var(--color-cyan);
    flex-shrink: 0;
  }
  .cap-text a {
    color: var(--color-blue);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
