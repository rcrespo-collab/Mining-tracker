---
import { credentialsForSector, type SectorKey } from '../content/shared';
import { routeFor, type Locale } from '../i18n/routes';
import { ui } from '../i18n/ui';
import CredentialCard from './CredentialCard.astro';
import Cta from './Cta.astro';

interface Props {
  locale: Locale;
  sector: SectorKey;
  heading: string;
  /** cap the number shown */
  limit?: number;
}
const { locale, sector, heading, limit = 3 } = Astro.props;
const t = ui[locale];
const items = credentialsForSector(sector).slice(0, limit);
// Deep-link the credentials page pre-filtered to this sector.
const credHref = `${routeFor('credentials', locale)}?sector=${sector}`;
---

{
  items.length > 0 && (
    <section class="section related-creds surface-mist">
      <div class="container">
        <h2 class="related-heading">{heading}</h2>
        <div class="related-grid">
          {items.map((c) => (
            <CredentialCard credential={c} locale={locale} />
          ))}
        </div>
        <div class="related-cta">
          <Cta href={credHref} label={t.cta.relatedCredentials} variant="outline" />
        </div>
      </div>
    </section>
  )
}

<style>
  .related-heading {
    font-size: var(--text-display-m);
    margin-bottom: 2rem;
  }
  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .related-cta {
    margin-top: 2.5rem;
  }
  @media (min-width: 720px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1040px) {
    .related-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
