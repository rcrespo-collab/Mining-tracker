---
import PageLayout from '../layouts/PageLayout.astro';
import ServiceCard from './ServiceCard.astro';
import RelatedCredentials from './RelatedCredentials.astro';
import ClosingCta from './ClosingCta.astro';
import type { SectorPageContent } from '../content/types';
import type { SiteContent } from '../content/types';
import { serviceRouteKey } from '../content/shared';
import { routeFor, type Locale } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
  content: SectorPageContent;
  /** service {title,body} lookup by key, from the whatWeDo content */
  services: SiteContent['whatWeDo']['services'];
  closingHeading: string;
}
const { locale, content: p, services, closingHeading } = Astro.props;
const t = ui[locale];

const serviceByKey = Object.fromEntries(services.map((s) => [s.key, s]));
const exploreLabel = locale === 'pt' ? 'Explorar' : 'Explore';
---

<PageLayout
  locale={locale}
  title={p.meta.title}
  description={p.meta.description}
  eyebrow={t.nav.sectors}
  heading={p.heading}
  breadcrumb={[
    { label: t.breadcrumbHome, href: routeFor('home', locale) },
    { label: t.nav.sectors, href: routeFor('sectors', locale) },
    { label: p.heading },
  ]}
>
  <section class="section">
    <div class="container-narrow">
      {p.paras.map((para) => <p class="sector-para">{para}</p>)}
    </div>
  </section>

  <section class="section surface-mist">
    <div class="container">
      <p class="eyebrow">{p.servicesLabel}</p>
      <div class="sector-services">
        {
          p.serviceKeys.map((key) => {
            const svc = serviceByKey[key];
            return (
              <ServiceCard
                href={routeFor(serviceRouteKey[key], locale)}
                title={svc.title}
                body={svc.body}
                cta={exploreLabel}
              />
            );
          })
        }
      </div>
    </div>
  </section>

  <RelatedCredentials locale={locale} sector={p.sectorKey} heading={p.credentialsLabel} limit={3} />

  <ClosingCta heading={closingHeading} ctaHref={routeFor('contact', locale)} ctaLabel={t.cta.primary} />
</PageLayout>

<style>
  .sector-para {
    font-size: var(--text-body-l);
    color: var(--color-graphite);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .sector-para:last-child {
    margin-bottom: 0;
  }
  .sector-services {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 3rem;
  }
  @media (min-width: 760px) {
    .sector-services {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
