---
import { routeFor, normalizePath, withBase, type Locale } from '../i18n/routes';
import { ui } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const currentPath = normalizePath(Astro.url.pathname);

const navItems = [
  { label: t.nav.about, href: routeFor('about', locale), match: 'about' },
  { label: t.nav.whatWeDo, href: routeFor('what-we-do', locale), match: 'what-we-do' },
  { label: t.nav.sectors, href: routeFor('sectors', locale), match: 'sectors' },
  { label: t.nav.credentials, href: routeFor('credentials', locale), match: 'credentials' },
  { label: t.nav.approach, href: routeFor('approach', locale), match: 'approach' },
];

const contactHref = routeFor('contact', locale);
const homeHref = routeFor('home', locale);

function isActive(href: string): boolean {
  const h = normalizePath(href);
  if (h === '/' || h === '/pt/') return currentPath === h;
  return currentPath === h || currentPath.startsWith(h + '/');
}
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a href={homeHref} class="brand" aria-label="Nyawira Consulting — home">
      <img src={withBase('/logos/nyawira-mark.svg')} width="26" height="26" alt="" class="brand-mark" />
      <span class="brand-name">Nyawira</span>
    </a>

    <nav class="primary-nav" aria-label={locale === 'pt' ? 'Navegação principal' : 'Primary'}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <LanguageSwitcher locale={locale} />
      <a href={contactHref} class="btn btn-primary header-cta">{t.cta.primary}</a>
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="menu-toggle-label">{t.menu.open}</span>
        <span class="menu-bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<!-- Full-screen overlay menu (mobile) -->
<div id="mobile-menu" class="mobile-menu on-dark" data-mobile-menu hidden>
  <div class="mobile-menu-inner container">
    <div class="mobile-menu-top">
      <span class="mono mobile-menu-eyebrow">Nyawira</span>
      <button type="button" class="menu-close" data-menu-close>{t.menu.close}</button>
    </div>
    <nav aria-label={locale === 'pt' ? 'Navegação móvel' : 'Mobile'}>
      <ul class="mobile-nav-list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mobile-menu-foot">
      <LanguageSwitcher locale={locale} />
      <a href={contactHref} class="btn btn-primary">{t.cta.primary}</a>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-paper);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms var(--ease-out);
  }
  .site-header[data-scrolled='true'] {
    border-bottom-color: var(--color-hairline);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--color-ink);
    flex-shrink: 0;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .primary-nav {
    display: none;
    flex: 1;
  }
  .primary-nav ul {
    display: flex;
    gap: clamp(1rem, 2.2vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
    justify-content: center;
  }
  .primary-nav a {
    color: var(--color-graphite);
    text-decoration: none;
    font-size: 0.95rem;
    padding: 0.4rem 0;
    border-bottom: 2px solid transparent;
    transition: color 140ms var(--ease-out), border-color 140ms var(--ease-out);
  }
  .primary-nav a:hover {
    color: var(--color-ink);
  }
  .primary-nav a[aria-current='page'] {
    color: var(--color-ink);
    border-bottom-color: var(--color-cyan);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }
  .header-cta {
    display: none;
    padding: 0.6rem 1.1rem;
  }
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink);
    padding: 0.4rem;
  }
  .menu-bars {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    width: 20px;
  }
  .menu-bars span {
    height: 2px;
    background: var(--color-ink);
    display: block;
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--color-ink);
    overflow-y: auto;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    padding-block: 1.5rem 3rem;
  }
  .mobile-menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3rem;
  }
  .mobile-menu-eyebrow {
    color: var(--color-cyan);
  }
  .menu-close {
    background: none;
    border: none;
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    padding: 0.4rem;
  }
  .mobile-nav-list {
    list-style: none;
    margin: 3rem 0 auto;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mobile-nav-list a {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 8vw, 2.5rem);
    color: var(--color-paper);
    text-decoration: none;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .mobile-nav-list a:hover {
    color: var(--color-cyan);
  }
  .mobile-menu-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 900px) {
    .primary-nav {
      display: flex;
    }
    .header-cta {
      display: inline-flex;
    }
    .menu-toggle {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
  const closeBtn = document.querySelector('[data-menu-close]');

  // Hairline border appears after 40px of scroll.
  const onScroll = () => {
    if (!header) return;
    header.setAttribute('data-scrolled', window.scrollY > 40 ? 'true' : 'false');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  let lastFocused: HTMLElement | null = null;
  const openMenu = () => {
    if (!menu || !toggle) return;
    lastFocused = document.activeElement as HTMLElement;
    menu.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    const firstLink = menu.querySelector('a, button') as HTMLElement | null;
    firstLink?.focus();
  };
  const closeMenu = () => {
    if (!menu || !toggle) return;
    menu.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    lastFocused?.focus();
  };

  toggle?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).tagName === 'A') closeMenu();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) closeMenu();
  });
</script>
