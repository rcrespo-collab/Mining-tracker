---
import PageLayout from '../../layouts/PageLayout.astro';
import SectorGrid from '../../components/SectorGrid.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import { en as c } from '../../content/en';
import { ui } from '../../i18n/ui';
import { routeFor } from '../../i18n/routes';

const locale = 'en' as const;
const t = ui[locale];
const p = c.sectors;
const sectorLinks = p.items.map((s) => ({ label: s.label, href: routeFor(s.key, locale) }));
---

<PageLayout
  locale={locale}
  title={p.meta.title}
  description={p.meta.description}
  eyebrow={t.nav.sectors}
  heading={p.heading}
  lede={p.opening}
  breadcrumb={[{ label: t.breadcrumbHome, href: routeFor('home', locale) }, { label: p.heading }]}
>
  <section class="section">
    <div class="container">
      <SectorGrid sectors={sectorLinks} />
    </div>
  </section>

  <ClosingCta heading={c.contact.heading} ctaHref={routeFor('contact', locale)} ctaLabel={t.cta.primary} />
</PageLayout>
