---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import SectorGrid from '../components/SectorGrid.astro';
import LogoRow from '../components/LogoRow.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { en as c } from '../content/en';
import { ui } from '../i18n/ui';
import { routeFor } from '../i18n/routes';

const locale = 'en' as const;
const t = ui[locale];
const h = c.home;

const serviceHref: Record<string, string> = {
  strategic: routeFor('strategic-advisory', locale),
  investment: routeFor('investment-advisory', locale),
  project: routeFor('project-management', locale),
};

const sectorLinks = c.sectors.items.map((s) => ({ label: s.label, href: routeFor(s.key, locale) }));
---

<BaseLayout locale={locale} title={h.meta.title} description={h.meta.description}>
  <!-- Hero -->
  <section class="hero surface-gradient on-dark">
    <div class="container hero-inner animate-rise">
      <p class="eyebrow">Nyawira Consulting</p>
      <h1 class="hero-h1">{h.heroH1}</h1>
      <p class="hero-sub lede">{h.heroSub}</p>
      <div class="hero-actions">
        <Cta href={routeFor('contact', locale)} label={t.cta.primary} variant="primary" />
        <Cta href={routeFor('what-we-do', locale)} label={t.nav.whatWeDo} variant="outline" />
      </div>
    </div>
  </section>

  <!-- Three pillars -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{h.pillarsEyebrow}</p>
        <p class="section-intro">{h.pillarsIntro}</p>
      </div>
      <ol class="pillars">
        {
          h.pillars.map((p) => (
            <li class="pillar">
              <a class="pillar-link" href={serviceHref[p.key]}>
                <h2 class="pillar-title">{p.title}</h2>
              </a>
              <p class="pillar-body">{p.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Proof strip -->
  <section class="section surface-ink on-dark proof-section">
    <div class="container">
      <p class="eyebrow">{h.proofEyebrow}</p>
      <ul class="proof-strip">
        {
          h.proof.map((p) => (
            <li class="proof-item">
              <span class="mono proof-value">{p.value}</span>
              <span class="proof-label">{p.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Why Nyawira -->
  <section class="section surface-mist">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{h.whyEyebrow}</p>
        <p class="section-intro">{h.whyIntro}</p>
      </div>
      <ul class="why-grid">
        {
          h.why.map((w) => (
            <li class="why-item">
              <span class="why-rule" aria-hidden="true" />
              <h3 class="why-title">{w.title}</h3>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Approach teaser -->
  <section class="section">
    <div class="container approach-teaser">
      <p class="eyebrow">{h.approachTeaserEyebrow}</p>
      <p class="approach-teaser-text">{h.approachTeaser}</p>
      <Cta href={routeFor('approach', locale)} label={h.approachTeaserCta} variant="outline" />
    </div>
  </section>

  <!-- Sectors -->
  <section class="section surface-mist">
    <div class="container sectors-block">
      <div class="sectors-head">
        <p class="eyebrow">{h.sectorsEyebrow}</p>
        <p class="section-intro">{h.sectorsIntro}</p>
      </div>
      <div class="sectors-list">
        <SectorGrid sectors={sectorLinks} />
      </div>
    </div>
  </section>

  <!-- Team credibility -->
  <section class="section">
    <div class="container">
      <div class="team-block">
        <p class="eyebrow">{h.teamEyebrow}</p>
        <p class="team-paragraph">{h.teamParagraph}</p>
      </div>
      <div class="team-logos">
        <LogoRow caption={h.logoCaption} />
      </div>
    </div>
  </section>

  <ClosingCta
    heading={h.closingHeading}
    body={h.closingBody}
    ctaHref={routeFor('contact', locale)}
    ctaLabel={t.cta.primary}
  />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(4rem, 11vw, 8.5rem);
  }
  .hero-inner {
    max-width: 60rem;
  }
  .hero-h1 {
    font-size: var(--text-display-xl);
    color: var(--color-paper);
    margin-top: 1.25rem;
    text-wrap: balance;
    max-width: 20ch;
  }
  .hero-sub {
    margin-top: 1.75rem;
    font-size: var(--text-body-l);
    max-width: 44ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .section-head {
    max-width: 44rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .section-intro {
    font-size: var(--text-display-m);
    font-family: var(--font-display);
    color: var(--color-ink);
    margin-top: 0.75rem;
    line-height: 1.2;
    text-wrap: balance;
  }

  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    counter-reset: none;
  }
  .pillar {
    border-top: 1px solid var(--color-hairline);
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .pillar-step {
    color: var(--color-slate);
    letter-spacing: 0.1em;
  }
  .pillar-link {
    text-decoration: none;
  }
  .pillar-title {
    font-size: var(--text-display-m);
    color: var(--color-ink);
    transition: color 140ms var(--ease-out);
  }
  .pillar-link:hover .pillar-title {
    color: var(--color-blue);
  }
  .pillar-body {
    color: var(--color-graphite);
    line-height: 1.6;
  }

  .proof-section {
    background: var(--color-ink);
  }
  .proof-strip {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .proof-item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .proof-value {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    color: var(--color-cyan);
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    line-height: 1;
  }
  .proof-label {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1rem;
    line-height: 1.5;
  }

  .why-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .why-item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-hairline);
  }
  .why-rule {
    width: 2rem;
    height: 2px;
    background: var(--color-cyan);
  }
  .why-title {
    font-size: 1.25rem;
    color: var(--color-ink);
    line-height: 1.25;
  }

  .approach-teaser {
    max-width: 52rem;
  }
  .approach-teaser-text {
    font-family: var(--font-display);
    font-size: var(--text-display-m);
    line-height: 1.25;
    color: var(--color-ink);
    margin: 1rem 0 2rem;
    text-wrap: balance;
  }

  .sectors-block {
    display: grid;
    gap: 2rem;
  }
  .team-block {
    max-width: 60rem;
    margin-bottom: 3rem;
  }
  .team-paragraph {
    font-size: var(--text-body-l);
    color: var(--color-graphite);
    margin-top: 1rem;
    line-height: 1.65;
  }

  @media (min-width: 720px) {
    .pillars {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
    .proof-strip {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
    .why-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 3rem;
    }
    .sectors-block {
      grid-template-columns: 1fr 1.4fr;
      gap: 3rem;
      align-items: start;
    }
  }
  @media (min-width: 1024px) {
    .why-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
