---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { pt as c } from '../../content/pt';
import { ui } from '../../i18n/ui';
import { routeFor } from '../../i18n/routes';

const locale = 'pt' as const;
const t = ui[locale];
const p = c.contact;
---

<PageLayout
  locale={locale}
  title={p.meta.title}
  description={p.meta.description}
  eyebrow={t.footer.contactHeading}
  heading={p.heading}
  lede={p.lede}
  breadcrumb={[{ label: t.breadcrumbHome, href: routeFor('home', locale) }, { label: p.heading }]}
>
  <section class="section">
    <div class="container contact-grid">
      <div class="contact-form-col">
        <ContactForm locale={locale} />
      </div>
      <aside class="contact-direct">
        <h2 class="mono direct-label">{p.directLabel}</h2>
        <ul class="direct-list">
          <li>
            <a href={`mailto:${p.email}`}>{p.email}</a>
          </li>
          <li><span class="direct-muted">{p.address}</span></li>
          <li><a href={p.linkedin}>LinkedIn</a></li>
        </ul>
      </aside>
    </div>
  </section>
</PageLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  .direct-label {
    color: var(--color-blue);
    letter-spacing: 0.1em;
    margin-bottom: 1.25rem;
  }
  .direct-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .direct-list a {
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-hairline);
    padding-bottom: 0.15rem;
  }
  .direct-list a:hover {
    color: var(--color-blue);
    border-color: var(--color-blue);
  }
  .direct-muted {
    color: var(--color-slate);
  }
  @media (min-width: 860px) {
    .contact-grid {
      grid-template-columns: 1.5fr 1fr;
      gap: 4rem;
    }
  }
</style>
