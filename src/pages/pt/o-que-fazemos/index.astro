---
import PageLayout from '../../../layouts/PageLayout.astro';
import ServiceCard from '../../../components/ServiceCard.astro';
import ClosingCta from '../../../components/ClosingCta.astro';
import { pt as c } from '../../../content/pt';
import { ui } from '../../../i18n/ui';
import { routeFor } from '../../../i18n/routes';

const locale = 'pt' as const;
const t = ui[locale];
const w = c.whatWeDo;

const serviceKeyToRoute: Record<string, string> = {
  strategic: 'strategic-advisory',
  investment: 'investment-advisory',
  project: 'project-management',
};
const seeMore = 'Explorar';
---

<PageLayout
  locale={locale}
  title={w.meta.title}
  description={w.meta.description}
  eyebrow={t.nav.whatWeDo}
  heading={w.heading}
  lede={w.opening}
  breadcrumb={[{ label: t.breadcrumbHome, href: routeFor('home', locale) }, { label: w.heading }]}
>
  <section class="section">
    <div class="container">
      <p class="mono lifecycle-label">{w.lifecycleLabel}</p>
      <ol class="lifecycle">
        {
          w.lifecycle.map((step, i) => (
            <li class="lifecycle-step">
              <span class="lifecycle-dot" aria-hidden="true" />
              <span class="lifecycle-text">{step}</span>
              {i < w.lifecycle.length - 1 && <span class="lifecycle-connector" aria-hidden="true" />}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section surface-mist">
    <div class="container">
      <div class="services-grid">
        {
          w.services.map((s) => (
            <ServiceCard
              href={routeFor(serviceKeyToRoute[s.key], locale)}
              title={s.title}
              body={s.body}
              cta={seeMore}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">{w.specialistLabel}</p>
      <div class="specialist-row">
        {
          w.specialist.map((s) => (
            <a class="specialist-card" href={routeFor(s.key, locale)}>
              <h2 class="specialist-title">{s.title}</h2>
              <p class="specialist-body">{s.body}</p>
              <span class="specialist-cta">
                {seeMore}
                <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h9M8 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <ClosingCta heading={c.contact.heading} ctaHref={routeFor('contact', locale)} ctaLabel={t.cta.primary} />
</PageLayout>

<style>
  .lifecycle-label {
    color: var(--color-slate);
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
  }
  .lifecycle {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .lifecycle-step {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    column-gap: 1rem;
    position: relative;
    padding-bottom: 1.5rem;
  }
  .lifecycle-dot {
    width: 10px;
    height: 10px;
    margin-top: 0.4rem;
    background: var(--color-blue);
    flex-shrink: 0;
  }
  .lifecycle-connector {
    position: absolute;
    left: 4px;
    top: 1.1rem;
    bottom: 0;
    width: 1px;
    background: var(--color-hairline);
  }
  .lifecycle-text {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-ink);
    letter-spacing: 0.02em;
  }
  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 3rem;
  }
  .specialist-row {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .specialist-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2rem;
    text-decoration: none;
    border: 1px solid var(--color-hairline);
    color: var(--color-graphite);
    transition: border-color 160ms var(--ease-out);
  }
  .specialist-card:hover {
    border-color: var(--color-ink);
  }
  .specialist-title {
    font-size: var(--text-display-m);
    color: var(--color-ink);
  }
  .specialist-body {
    color: var(--color-graphite);
    line-height: 1.6;
    flex: 1;
  }
  .specialist-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-blue);
    font-weight: 500;
  }
  @media (min-width: 720px) {
    .lifecycle {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    }
    .lifecycle-step {
      grid-template-columns: 1fr;
      row-gap: 0.9rem;
      padding: 0 1.25rem 0 0;
    }
    .lifecycle-dot {
      margin-top: 0;
    }
    .lifecycle-connector {
      left: 10px;
      top: 4px;
      bottom: auto;
      right: 0;
      width: auto;
      height: 1px;
    }
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .specialist-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
