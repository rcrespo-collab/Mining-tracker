---
import BaseLayout from './BaseLayout.astro';
import { type Locale } from '../i18n/routes';

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  locale: Locale;
  title: string;
  description: string;
  eyebrow?: string;
  heading: string;
  lede?: string;
  breadcrumb?: Crumb[];
  heroVariant?: 'plain' | 'gradient';
  schemas?: Record<string, unknown>[];
}

const {
  locale,
  title,
  description,
  eyebrow,
  heading,
  lede,
  breadcrumb = [],
  heroVariant = 'plain',
  schemas = [],
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.nyawiraconsulting.com';

// BreadcrumbList JSON-LD for nested pages.
const allSchemas = [...schemas];
if (breadcrumb.length > 0) {
  allSchemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumb.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      ...(c.href ? { item: `${site}${c.href === '/' ? '' : c.href}` } : {}),
    })),
  });
}

const heroDark = heroVariant === 'gradient';
---

<BaseLayout locale={locale} title={title} description={description} schemas={allSchemas}>
  <header class:list={['page-hero', { 'surface-gradient on-dark': heroDark }]}>
    <div class="container">
      {
        breadcrumb.length > 0 && (
          <nav class="breadcrumb" aria-label={locale === 'pt' ? 'Trilho' : 'Breadcrumb'}>
            <ol>
              {breadcrumb.map((c, i) => (
                <li>
                  {c.href && i < breadcrumb.length - 1 ? (
                    <a href={c.href}>{c.label}</a>
                  ) : (
                    <span aria-current="page">{c.label}</span>
                  )}
                  {i < breadcrumb.length - 1 && <span class="crumb-sep" aria-hidden="true">/</span>}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <div class="page-hero-content animate-rise">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 class="page-hero-title">{heading}</h1>
        {lede && <p class="page-hero-lede">{lede}</p>}
      </div>
    </div>
  </header>

  <slot />
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--color-hairline);
  }
  .page-hero.surface-gradient {
    border-bottom: none;
  }
  .breadcrumb {
    margin-bottom: 2rem;
  }
  .breadcrumb ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
  }
  .breadcrumb a {
    color: var(--color-slate);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-ink);
  }
  .breadcrumb [aria-current='page'] {
    color: var(--color-ink);
  }
  .crumb-sep {
    color: var(--color-hairline);
    margin-left: 0.5rem;
  }
  .surface-gradient .breadcrumb a {
    color: rgba(255, 255, 255, 0.7);
  }
  .surface-gradient .breadcrumb a:hover,
  .surface-gradient .breadcrumb [aria-current='page'] {
    color: var(--color-paper);
  }
  .surface-gradient .crumb-sep {
    color: rgba(255, 255, 255, 0.4);
  }
  .page-hero-content {
    max-width: 54rem;
  }
  .page-hero-title {
    font-size: var(--text-display-l);
    margin-top: 0.75rem;
    text-wrap: balance;
  }
  .page-hero-lede {
    margin-top: 1.5rem;
    font-size: var(--text-body-l);
    color: var(--color-graphite);
    max-width: 46ch;
  }
  .surface-gradient .page-hero-lede {
    color: rgba(255, 255, 255, 0.9);
  }
</style>
