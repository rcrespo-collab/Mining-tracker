{
  "expo": {
    "name": "Repair",
    "slug": "repair",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "repair",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Repair uses Face ID to keep your private journal locked."
      }
    },
    "android": {
      "package": "com.repair.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "color": "#7C8A72"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
